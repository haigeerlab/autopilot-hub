<?xml version="1.0" encoding="UTF-8"?>
<!--
  Weekly readiness recheck (slice 3) on the user's Mac. Example only: installing it needs the user's OK.
  Replace /PATH/TO/autopilot-hub with a clean checkout of autopilot-hub at a reviewed commit.
  Install:   cp examples/com.haigeerlab.autopilot-recheck.plist ~/Library/LaunchAgents/ &&
             launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.haigeerlab.autopilot-recheck.plist
  Uninstall: launchctl bootout gui/$(id -u)/com.haigeerlab.autopilot-recheck
  launchd runs a missed StartCalendarInterval job once the Mac wakes up.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.haigeerlab.autopilot-recheck</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-B</string>
    <string>/PATH/TO/autopilot-hub/recheck/run.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>17</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/autopilot-recheck.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/autopilot-recheck.err.log</string>
</dict>
</plist>
